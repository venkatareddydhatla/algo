# Native Windows / Docker-free dry-run profile.
# Copied to `.env` by deploy/windows/native/setup-native.ps1 when `.env` is missing.
# Never commit real values.

# --- Core (SQLite + in-process Redis stub; no Docker / Postgres / Redis) ---
PERSISTENCE_PROFILE=local
DATABASE_URL=sqlite:///./data/options_portal.local.sqlite
REDIS_URL=memory://local
CONFIG_PATH=./config/local.yaml

# Portal session / bootstrap admin (local only)
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
SESSION_SECRET=generate-a-long-random-string-native

# --- Upstox (optional; without ACCESS_TOKEN → synthetic market data) ---
# Put real values only in local `.env` (gitignored). Never commit secrets.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback
# UPSTOX_ACCESS_TOKEN=
# UPSTOX_REFRESH_TOKEN=
# Optional JSON map for symbols missing from the built-in instrument table:
# UPSTOX_INSTRUMENT_MAP={"SYRMA":"NSE_EQ|INE0DYJ01015"}

# --- Trading safety (keep dry_run) ---
TRADING_MODE=dry_run
TRADING_HALT=false

# Bind (127.0.0.1 only)
BIND_HOST=127.0.0.1
API_PORT=8000

# --- Gmail SMTP (dry-run fill + 16:00 IST daily summary) ---
# Create a Google App Password; put it only in local .env — never commit or paste in chat.
# GMAIL_APP_PASSWORD=
# GMAIL_USER=venkatareddy.dhatla@gmail.com
# NOTIFY_EMAIL_TO=venkatareddy.dhatla@gmail.com
# Test: .\.venv\Scripts\python.exe scripts\send_test_email.py
