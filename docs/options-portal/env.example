# Copy to project root as `.env` and chmod 600.
# Never commit real values. Prefer Docker secrets / Vault for anything beyond local dry-run.

# --- Core ---
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql+asyncpg://portal:change-me-strong@127.0.0.1:5432/options_portal
REDIS_URL=redis://127.0.0.1:6379/0
CONFIG_PATH=./config/local.yaml

# Portal session / bootstrap admin (generate hash offline; do not put raw password in git)
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
SESSION_SECRET=generate-a-long-random-string

# --- Upstox (from developer console; values only in local .env — never commit) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback
# When UPSTOX_ACCESS_TOKEN is set, worker uses live candles for TA; else synthetic.
# UPSTOX_ACCESS_TOKEN=
# UPSTOX_REFRESH_TOKEN=
# Optional JSON symbol→instrument_key overrides:
# UPSTOX_INSTRUMENT_MAP={"CUSTOM":"NSE_EQ|INE000000000"}

# --- Trading safety ---
TRADING_MODE=dry_run
TRADING_HALT=false

# --- Optional alerts ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

# --- Optional FinBERT sidecar ---
# FINBERT_URL=http://127.0.0.1:8081

# --- Optional Vault ---
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_SECRET_PATH=secret/data/options-portal
